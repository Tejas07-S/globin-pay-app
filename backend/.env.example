# Copy this to .env and fill in real values. .env itself should stay
# out of version control (already covered by .gitignore).

MONGO_URL="mongodb://localhost:27017"
DB_NAME="globinpay"

# Generate your own: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-to-a-long-random-string"

FOUNDER_EMAILS=""

# Optional — AI assistant (Finn). Provider order: Gemini -> OpenAI -> Groq -> Anthropic -> rule-based.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Optional — set to enable Stripe top-ups / GlobalPay Plus
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""

APP_URL="http://localhost:8000"
