# Local development environment — generated for you, not committed to git.
# For production, generate a fresh JWT_SECRET and never reuse this one.

MONGO_URL="mongodb://localhost:27017"
DB_NAME="globinpay"

# Generated automatically — safe for local dev only.
JWT_SECRET="49c9d516316678bd1a01295fa669d0ab16bc884439247e20dba679788b39cb22"

# Comma-separated emails that get auto-promoted to admin/founder on login.
# Set this to your own email to unlock the Founder/Admin panel.
FOUNDER_EMAILS=""

# --- Optional: AI Assistant (Finn) ---
# Provider order: Gemini -> OpenAI -> Groq -> Anthropic -> rule-based.
# Set any combination; each is tried in order and skipped if not configured
# or if it fails. Leave all blank and the assistant still works fully via
# the rule-based responder — never a hardcoded/fake answer, never a
# visible error.
GEMINI_API_KEY="AQ.Ab8RN6IJGOZ1e_QH-NLn_3eR6jIH1xdzojkzkBTW9ZZeHEWNZA"
GEMINI_MODEL="gemini-flash-latest"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Groq — free tier, no credit card, from https://console.groq.com/keys
GROQ_API_KEY="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"
GROQ_MODEL="openai/gpt-oss-120b"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Optional: Stripe (top-ups + GlobalPay Plus) ---
# Leave blank and those endpoints return 501 instead of crashing the server.
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public URL the app is served from (used for Stripe redirect URLs).
# Defaults to localhost:8000 if unset — only needed once you configure Stripe.
APP_URL="http://localhost:8000"
